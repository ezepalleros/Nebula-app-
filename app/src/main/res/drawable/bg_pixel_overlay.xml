<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#99FFFFFF" />
        </shape>
    </item>
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="90" android:startColor="#08FFFFFF" android:centerColor="#22FFFFFF" android:endColor="#08FFFFFF" />
        </shape>
    </item>
</layer-list>

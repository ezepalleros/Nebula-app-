<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Atrás"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Adivina la canción"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Headline"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Todo ocurre offline con tu biblioteca."
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/setupCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:id="@+id/setupTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preparar partida"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/playlistInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="Playlist">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/playlistField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/roundsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="Cantidad de rondas"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/roundsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rounds5"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="5" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rounds10"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="10" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rounds15"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="15" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rounds20"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="20" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startButton"
                    style="@style/Widget.AppIncreible.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="Empezar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/playCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:id="@+id/roundStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Ronda 1/10 · 0,5 s"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/levelStrip"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playFragmentButton"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="@dimen/space_24"
                    android:contentDescription="Reproducir fragmento"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:cornerRadius="52dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="42dp" />

                <TextView
                    android:id="@+id/listenHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:text="Podés repetir el fragmento todas las veces que quieras."
                    android:textAppearance="@style/TextAppearance.AppIncreible.Caption" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/answerInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:hint="Buscar canción">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/answerField"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:minHeight="64dp"
                        android:completionThreshold="1"
                        android:dropDownVerticalOffset="6dp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="17sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/skipButton"
                        style="@style/Widget.AppIncreible.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="Saltar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendButton"
                        style="@style/Widget.AppIncreible.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Enviar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/revealCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:id="@+id/revealStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¡Correcto!"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                    android:textStyle="bold" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/revealArtwork"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:contentDescription="Portada de la respuesta"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/AppIncreibleRoundedArtworkShape" />

                <TextView
                    android:id="@+id/revealTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/revealArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body" />

                <TextView
                    android:id="@+id/revealPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextRoundButton"
                    style="@style/Widget.AppIncreible.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="Siguiente ronda" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultsCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:id="@+id/resultsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resultado"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultsScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Puntaje total: 0"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Headline"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultsHits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body" />

                <TextView
                    android:id="@+id/resultsAverage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body" />

                <TextView
                    android:id="@+id/resultsBest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playAgainButton"
                    style="@style/Widget.AppIncreible.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="Jugar de nuevo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changePlaylistButton"
                    style="@style/Widget.AppIncreible.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="Cambiar playlist" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

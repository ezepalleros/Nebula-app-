<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.appincreible.musicplayer.themes.view.PlayerBackgroundView
        android:id="@+id/playerBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/artworkGradientBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.appincreible.musicplayer.themes.view.EqualizerBackgroundView
        android:id="@+id/equalizerSkinBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/skinScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ui_scrim_dark_40"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/immersiveRendererHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/standardPlayerScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/bottom_nav_height"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_20"
            android:paddingBottom="@dimen/space_24">

            <FrameLayout
                android:id="@+id/artworkStage"
                android:layout_width="match_parent"
                android:layout_height="430dp">

                <com.appincreible.musicplayer.themes.view.RingVisualizerView
                    android:id="@+id/ringVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/metadataRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/space_12">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="2"
                        android:text="Nada reproduciéndose"
                        android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="2"
                        android:text="Elegí una canción o una radio"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                        android:id="@+id/album"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/favoriteButton"
                    android:layout_width="@dimen/music_action_size"
                    android:layout_height="@dimen/music_action_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Favorito"
                    android:padding="@dimen/space_8"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_favorite_border" />
            </LinearLayout>

            <com.appincreible.musicplayer.themes.view.PlayerProgressSeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:max="1000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="0:00"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/shuffleButton"
                    android:layout_width="@dimen/music_action_size"
                    android:layout_height="@dimen/music_action_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Orden aleatorio"
                    android:padding="@dimen/space_12"
                    app:srcCompat="@drawable/ic_shuffle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previous"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="@dimen/bottom_nav_height"
                    android:layout_height="@dimen/bottom_nav_height"
                    android:layout_marginStart="@dimen/space_8"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:cornerRadius="@dimen/music_action_size"
                    app:icon="@drawable/ic_skip_previous"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playPause"
                    android:layout_width="@dimen/music_row_height"
                    android:layout_height="@dimen/music_row_height"
                    android:layout_marginHorizontal="@dimen/space_12"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:cornerRadius="@dimen/music_action_size"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/next"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="@dimen/bottom_nav_height"
                    android:layout_height="@dimen/bottom_nav_height"
                    android:layout_marginEnd="@dimen/space_8"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:cornerRadius="@dimen/music_action_size"
                    app:icon="@drawable/ic_skip_next"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/repeatButton"
                    android:layout_width="@dimen/music_action_size"
                    android:layout_height="@dimen/music_action_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Modo repetir"
                    android:padding="@dimen/space_12"
                    app:srcCompat="@drawable/ic_repeat" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/queueToggleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/music_action_size"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8">

                <TextView
                    android:id="@+id/queueToggleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cola de reproducción"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/queueStateIcon"
                    android:layout_width="@dimen/bottom_nav_icon_size"
                    android:layout_height="@dimen/bottom_nav_icon_size"
                    android:layout_marginStart="@dimen/space_8"
                    android:contentDescription="Cola cerrada: tocá para abrir"
                    app:srcCompat="@drawable/ic_visibility_off" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/inlineQueueContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/inlineQueueEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16"
                    android:text="No hay canciones en la cola."
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/inlineQueueList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <TextView
                android:id="@+id/playMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="top"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="@dimen/music_action_size"
            android:layout_height="@dimen/music_action_size"
            android:minWidth="0dp"
            android:padding="0dp"
            app:cornerRadius="@dimen/music_action_size"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/headerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="REPRODUCIENDO"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moreButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="@dimen/music_action_size"
            android:layout_height="@dimen/music_action_size"
            android:minWidth="0dp"
            android:padding="0dp"
            app:cornerRadius="@dimen/music_action_size"
            app:icon="@drawable/ic_more_vert"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

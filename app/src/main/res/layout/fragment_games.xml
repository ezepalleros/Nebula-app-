<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/gamesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Juegos"
            android:textAppearance="@style/TextAppearance.AppIncreible.Headline"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gamesSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="Minijuegos con tu biblioteca, sin conexión."
            android:textAppearance="@style/TextAppearance.AppIncreible.Body" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/guessSongCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="112dp"
                android:padding="@dimen/space_16">

                <FrameLayout
                    android:id="@+id/gameIconContainer"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_chip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/gameIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="Adivina la canción"
                        android:src="@drawable/ic_gamepad"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/gameTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:text="Adivina la canción"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/gameArrow"
                    app:layout_constraintStart_toEndOf="@id/gameIconContainer"
                    app:layout_constraintTop_toTopOf="@id/gameIconContainer" />

                <TextView
                    android:id="@+id/gameDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Escuchá fragmentos cada vez más largos y adiviná la canción."
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body"
                    app:layout_constraintEnd_toStartOf="@id/gameArrow"
                    app:layout_constraintStart_toEndOf="@id/gameIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/gameTitle" />

                <TextView
                    android:id="@+id/gameArrow"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="34sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/intruderCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="112dp"
                android:padding="@dimen/space_16">

                <FrameLayout
                    android:id="@+id/intruderIconContainer"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_chip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/intruderIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="El intruso"
                        android:src="@drawable/ic_gamepad"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/intruderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:text="El intruso"
                    android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/intruderArrow"
                    app:layout_constraintStart_toEndOf="@id/intruderIconContainer"
                    app:layout_constraintTop_toTopOf="@id/intruderIconContainer" />

                <TextView
                    android:id="@+id/intruderDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Escuchá varios fragmentos y encontrá el que pertenece a otra canción."
                    android:textAppearance="@style/TextAppearance.AppIncreible.Body"
                    app:layout_constraintEnd_toStartOf="@id/intruderArrow"
                    app:layout_constraintStart_toEndOf="@id/intruderIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/intruderTitle" />

                <TextView
                    android:id="@+id/intruderArrow"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="34sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/gamesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Juegos"
            android:textAppearance="@style/TextAppearance.AppIncreible.Headline"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gamesSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="Minijuegos con tu biblioteca, sin conexión."
            android:textAppearance="@style/TextAppearance.AppIncreible.Body" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/guessSongCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <FrameLayout
                    android:id="@+id/gameIconContainer"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_game_icon_guess">

                    <ImageView
                        android:id="@+id/gameIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="Adivina la canción"
                        android:src="@drawable/ic_guess_song"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/gameTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adivina la canción"
                        android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/gameDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Escuchá fragmentos cada vez más largos y adiviná la canción."
                        android:textAppearance="@style/TextAppearance.AppIncreible.Caption" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/gameArrowContainer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_game_arrow_chip">

                    <TextView
                        android:id="@+id/gameArrow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/intruderCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <FrameLayout
                    android:id="@+id/intruderIconContainer"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_game_icon_intruder">

                    <ImageView
                        android:id="@+id/intruderIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="El intruso"
                        android:src="@drawable/ic_intruder_song"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/intruderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="El intruso"
                        android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/intruderDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Escuchá varios fragmentos y encontrá el que pertenece a otra canción."
                        android:textAppearance="@style/TextAppearance.AppIncreible.Caption" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/intruderArrowContainer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_game_arrow_chip">

                    <TextView
                        android:id="@+id/intruderArrow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/doubleMixCard"
            style="@style/Widget.AppIncreible.Card.Adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <FrameLayout
                    android:id="@+id/doubleMixIconContainer"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_game_icon_mix">

                    <ImageView
                        android:id="@+id/doubleMixIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="Mezcla doble"
                        android:src="@drawable/ic_double_mix"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/doubleMixTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mezcla doble"
                        android:textAppearance="@style/TextAppearance.AppIncreible.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/doubleMixDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Dos canciones suenan a la vez. Reconocé las dos."
                        android:textAppearance="@style/TextAppearance.AppIncreible.Caption" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/doubleMixArrowContainer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_game_arrow_chip">

                    <TextView
                        android:id="@+id/doubleMixArrow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
